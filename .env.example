LIVING_AGENT_ENVIRONMENT=development
LIVING_AGENT_DATABASE_URL=sqlite+aiosqlite:///./living_agent.db
LIVING_AGENT_OWNER_ID=owner-local
LIVING_AGENT_ADMIN_IDS=[]
# 生产环境必填。请使用至少 32 个字符的专用随机值。
# LIVING_AGENT_MANAGEMENT_API_TOKEN=
LIVING_AGENT_LOG_LEVEL=INFO
LIVING_AGENT_TEST_DISABLE_DELAYS=false
LIVING_AGENT_MODEL_PROVIDER=mock
LIVING_AGENT_MODEL_NAME=mock-chat-v1
# 使用 openai_compatible 时必填。需要包含 API 前缀，通常为 /v1。
# LIVING_AGENT_MODEL_API_BASE_URL=https://api.example.com/v1
# 非回环地址的模型 API 必填。
# LIVING_AGENT_MODEL_API_KEY=
LIVING_AGENT_MODEL_TIMEOUT_SECONDS=60.0
LIVING_AGENT_MODEL_MAX_OUTPUT_TOKENS=1024
LIVING_AGENT_MODEL_TEMPERATURE=0.7
LIVING_AGENT_MODEL_MAX_CONTEXT_CHARS=100000
LIVING_AGENT_MODEL_MAX_RESPONSE_BYTES=1048576
LIVING_AGENT_MODEL_ALLOW_INSECURE_HTTP=false
LIVING_AGENT_EMBEDDING_PROVIDER=mock
LIVING_AGENT_EMBEDDING_MODEL=mock-hash-v1
# 使用 openai_compatible 时必填。需要包含 API 前缀，通常为 /v1。
# LIVING_AGENT_EMBEDDING_API_BASE_URL=https://api.example.com/v1
# LIVING_AGENT_EMBEDDING_API_KEY=
# 可选：提供方支持的输出维度。
# LIVING_AGENT_EMBEDDING_DIMENSIONS=1536
LIVING_AGENT_EMBEDDING_TIMEOUT_SECONDS=15.0
LIVING_AGENT_EMBEDDING_MAX_BATCH_SIZE=32
LIVING_AGENT_EMBEDDING_MAX_INPUT_CHARS=12000
LIVING_AGENT_EMBEDDING_MAX_TOTAL_CHARS=48000
LIVING_AGENT_EMBEDDING_MAX_RESPONSE_BYTES=4194304
LIVING_AGENT_EMBEDDING_ALLOW_INSECURE_HTTP=false
LIVING_AGENT_CONFIG=config/default.yaml
LIVING_AGENT_PLUGIN_ROOT=plugins/examples
LIVING_AGENT_ENABLED_PLUGINS='["com.livingagent.calculator"]'
LIVING_AGENT_PLUGIN_TIMEOUT_SECONDS=2.0
# 生产环境请设为 required；没有受支持的操作系统沙箱时将启动失败。
LIVING_AGENT_PLUGIN_SANDBOX_MODE=auto
LIVING_AGENT_PERSONA_ROOT=personas/default
LIVING_AGENT_PROMPT_ROOT=prompts
# 启用根提示词修改前，将此项设为二次认证秘密的 sha256 摘要。
# LIVING_AGENT_ROOT_PROMPT_SECOND_FACTOR_SHA256=
LIVING_AGENT_PSYCHE_DECAY_HALF_LIFE_HOURS=12.0
LIVING_AGENT_SOCIAL_ENGAGE_UNITS_MIN=2
LIVING_AGENT_SOCIAL_ENGAGE_UNITS_MAX=3
LIVING_AGENT_SOCIAL_FOLLOWUP_DELAY_MIN_MS=300
LIVING_AGENT_SOCIAL_FOLLOWUP_DELAY_MAX_MS=650
LIVING_AGENT_SOCIAL_GROUP_AUTO_PARTICIPATION=false
LIVING_AGENT_SOCIAL_GROUP_MIN_USER_TURNS=5
LIVING_AGENT_SOCIAL_GROUP_COOLDOWN_SECONDS=60.0
LIVING_AGENT_NAPCAT_ENABLED=false
# 启用 NapCat 时必填。NapCat WebSocket 客户端必须使用相同令牌。
# LIVING_AGENT_NAPCAT_ACCESS_TOKEN=
LIVING_AGENT_NAPCAT_ACTION_TIMEOUT_SECONDS=5.0
LIVING_AGENT_NAPCAT_MAX_MESSAGE_CHARS=12000
LIVING_AGENT_NAPCAT_MAX_FRAME_BYTES=1048576
LIVING_AGENT_NAPCAT_MAX_IN_FLIGHT_EVENTS=16
LIVING_AGENT_OPENCLAW_BRIDGE_ENABLED=false
# 只与本地 OpenClaw 桥接插件共享。不要复用 Gateway 令牌。
# LIVING_AGENT_OPENCLAW_BRIDGE_ACCESS_TOKEN=
LIVING_AGENT_OPENCLAW_BRIDGE_ALLOWED_CHANNELS='["openclaw-weixin"]'
LIVING_AGENT_OPENCLAW_BRIDGE_ALLOWED_ACCOUNT_IDS=[]
LIVING_AGENT_OPENCLAW_BRIDGE_MAX_MESSAGE_CHARS=12000
LIVING_AGENT_OPENCLAW_BRIDGE_IDEMPOTENCY_ENTRIES=2048
