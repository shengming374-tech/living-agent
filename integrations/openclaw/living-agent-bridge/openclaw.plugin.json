{
  "id": "living-agent-bridge",
  "name": "LivingAgent 通道桥接",
  "version": "0.1.0",
  "description": "在 OpenClaw Agent 分发前，把选定通道消息转发给 LivingAgent。",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "endpoint": {
        "type": "string",
        "description": "LivingAgent OpenClaw 桥接端点。"
      },
      "token": {
        "type": "string",
        "description": "共享的 LivingAgent 桥接令牌。受管理部署优先使用 tokenEnv。"
      },
      "tokenEnv": {
        "type": "string",
        "description": "保存共享桥接令牌的环境变量。"
      },
      "channelId": {
        "type": "string",
        "description": "需要接管的 OpenClaw 通道 ID。"
      },
      "allowedAccountIds": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "可选的精确 OpenClaw 账户白名单。"
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 120000
      },
      "followupDelayMs": {
        "type": "integer",
        "minimum": 100,
        "maximum": 5000,
        "description": "LivingAgent 后续语言单元之间的延迟。"
      },
      "maxMessageChars": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100000
      },
      "allowRemoteEndpoint": {
        "type": "boolean",
        "description": "允许使用非回环 HTTPS LivingAgent 端点。"
      }
    }
  },
  "uiHints": {
    "token": {
      "label": "桥接令牌",
      "sensitive": true
    }
  }
}
